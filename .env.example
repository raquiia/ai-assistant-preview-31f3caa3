# Mode d'authentification frontend
# - "local" (défaut) : POST /auth/login sur le backend Fastify (ou mocks)
# - "cognito"        : SDK Amazon Cognito (production AWS)
VITE_AUTH_MODE=local

# Variables Cognito (requises uniquement si VITE_AUTH_MODE=cognito)
# Récupérables via `terraform output` après déploiement de _backend-reference/infra/aws
VITE_COGNITO_REGION=eu-west-3
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# API backend (utilisée quand VITE_USE_MOCKS=false)
VITE_API_URL=http://localhost:4000
VITE_USE_MOCKS=true
