NODE_ENV=development
APP_ORIGIN=http://localhost:5173
API_PORT=4000
WEB_PORT=5173
DATABASE_URL=postgresql://mp_user:mp_password@postgres:5432/mp_assistant?schema=public
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-west-3
S3_BUCKET=mp-knowledge
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
OPENSEARCH_URL=http://opensearch:9200
JWT_SECRET=replace-with-local-dev-secret
SECRET_ENCRYPTION_KEY=replace-with-32-byte-local-dev-key
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
SEARCH_PROVIDER=none
TAVILY_API_KEY=
SERPAPI_API_KEY=
ALLOWED_EMBED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

